{% comment %} Mozemo Signage - Live Infinity Mirror Letter Signs Configurator {% endcomment %}

<div class="infinity-configurator" id="infinity-configurator-{{ block.id }}" data-block-id="{{ block.id }}">

  <div class="infinity-configurator__preview">
    <div class="infinity-configurator__preview-inner">
      <span class="infinity-configurator__preview-text" data-preview-text>Your Text</span>
    </div>
  </div>

  <div class="infinity-configurator__panel">

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">1. Enter Your Text</label>
      <input type="text" class="infinity-configurator__text-input" data-text-input maxlength="30" placeholder="Type your text">
    </div>

    {% comment %} Dynamic @font-face injection for merchant-uploaded font files {% endcomment %}
    <style>
    {% for item in metaobjects["app--418838118401--infinity_font"].values %}
      {% if item.font_file.value.url %}
      @font-face {
        font-family: "moz-infinity-font-{{ item.system.handle }}";
        src: url("{{ item.font_file.value.url }}");
        font-display: swap;
      }
      {% endif %}
    {% endfor %}
    </style>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">2. Font</label>
      <select class="infinity-configurator__select" data-font-select>
        {% for item in metaobjects["app--418838118401--infinity_font"].values %}
          {% if item.font_file.value.url %}
            {% assign font_value = "moz-infinity-font-" | append: item.system.handle %}
          {% else %}
            {% assign font_value = item.css_font_family.value %}
          {% endif %}
          <option
            value="{{ font_value }}"
            {% if forloop.first %}selected{% endif %}>
            {{ item.name.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">3. Choose Size</label>
      <select class="infinity-configurator__select" data-size-select>
        {% for item in metaobjects["app--418838118401--infinity_size"].values %}
          <option
            value="{{ item.width_cm.value }}"
            data-price="{{ item.price_decimal.value | default: 0 }}"
            {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">4. LED Colour</label>
      <div class="infinity-configurator__swatches" data-colour-swatches>
        {% for colour in metaobjects["app--418838118401--infinity_colour"].values %}
          <button
            type="button"
            class="infinity-configurator__swatch{% if forloop.first %} is-selected{% endif %}"
            style="background-color: {{ colour.hex_code.value }};"
            data-colour-hex="{{ colour.hex_code.value }}"
            data-colour-price="{{ colour.extra_price_decimal.value | default: 0 }}"
            data-colour-name="{{ colour.name.value }}"
            title="{{ colour.name.value }}"
            aria-label="{{ colour.name.value }}">
          </button>
        {% endfor %}
      </div>
      <p class="infinity-configurator__selected-label" data-colour-name-label>
        {{ metaobjects["app--418838118401--infinity_colour"].values.first.name.value }}
      </p>
    </div>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">5. Frame Finish</label>
      <select class="infinity-configurator__select" data-frame-select>
        {% for item in metaobjects["app--418838118401--infinity_frame_finish"].values %}
          <option
            value="{{ item.label.value }}"
            data-price="{{ item.extra_price_decimal.value | default: 0 }}"
            {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">6. Mounting</label>
      <select class="infinity-configurator__select" data-mounting-select>
        {% for item in metaobjects["app--418838118401--infinity_mounting"].values %}
          <option
            value="{{ item.label.value }}"
            data-price="{{ item.extra_price_decimal.value | default: 0 }}"
            {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">7. Power Adapter</label>
      <select class="infinity-configurator__select" data-power-select>
        {% for item in metaobjects["app--418838118401--power_adapter"].values %}
          <option value="{{ item.label.value }}" {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="infinity-configurator__field">
      <label class="infinity-configurator__label">8. Add-ons</label>
      {% for addon in metaobjects["app--418838118401--infinity_addon"].values %}
        <label class="infinity-configurator__checkbox-row">
          <input
            type="checkbox"
            data-addon-checkbox
            data-price="{{ addon.extra_price_decimal.value | default: 0 }}"
            {% if addon.is_free.value %}checked{% endif %}>
          <span>{{ addon.label.value }}{% if addon.is_free.value %} (Free){% endif %}</span>
        </label>
      {% endfor %}
    </div>

    <div class="infinity-configurator__price-box">
      <span class="infinity-configurator__price-label">Total Price</span>
      <span class="infinity-configurator__price-value" data-total-price>$0.00</span>
    </div>

    <button
      type="button"
      class="infinity-configurator__add-to-cart"
      data-add-to-cart
      data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}"
      data-product-id="{{ product.id }}">
      Add to Cart
    </button>
    <p class="infinity-configurator__status" data-add-to-cart-status></p>

  </div>
</div>

{{ 'infinity-mirror-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'infinity-mirror-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Infinity Mirror Config",
  "target": "section",
  "settings": []
}
{% endschema %}