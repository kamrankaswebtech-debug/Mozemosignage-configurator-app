{% comment %} Mozemo Signage - Lightbox Signs (simple: shape, sides, size, design, frame colour). UI built by moz-configurator.js {% endcomment %}
<div data-moz-cfg="lightbox" data-block-id="{{ block.id }}" data-product-id="{{ product.id }}">
<script type="application/json" data-moz-data>{"opts":[{%- for o in metaobjects["app--418838118401--lightbox_option"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"c":{{ o.category.value | json }},"l":{{ o.label.value | json }},"hc":{{ o.hex_code.value | default: '' | json }},"k":{{ o.shape_key.value | default: '' | json }},"sd":{{ o.sides.value | default: 'single' | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"s":{{ o.sort_order.value | default: 999999 }}}{%- endfor -%}]}</script>
{%- render 'moz-cfg-common', walls: 'neon', power: false, install: false -%}
</div>

{% schema %}
{ "name": "Lightbox Configurator", "target": "section", "settings": [] }
{% endschema %}