{% comment %} Mozemo Signage - Live Neon Sign Configurator {% endcomment %}

{% assign default_bg_url = metaobjects["app--414412210177--neon_background_image"].values.first.image.value | image_url %}
<div class="neon-configurator" id="neon-configurator-{{ block.id }}" data-block-id="{{ block.id }}">

  <div class="neon-configurator__preview" data-preview-box{% if default_bg_url %} style="background-image: url('{{ default_bg_url }}');"{% endif %}>
    <div class="neon-configurator__preview-toggle">
      <span class="neon-configurator__toggle-label">OFF</span>
      <label class="neon-configurator__switch">
        <input type="checkbox" data-power-toggle checked>
        <span class="neon-configurator__switch-slider"></span>
      </label>
      <span class="neon-configurator__toggle-label">ON</span>
    </div>
    <div class="neon-configurator__preview-stage" data-preview-stage>
      <div class="neon-configurator__preview-inner" data-preview-inner>
        <span class="neon-configurator__preview-text" data-preview-text>Your Text</span>
        <span class="neon-configurator__preview-icons" data-preview-icons></span>
      </div>
      <div class="neon-configurator__dim-line neon-configurator__dim-line--width">
        <span class="neon-configurator__dim-label" data-width-label>0 cm</span>
      </div>
      <div class="neon-configurator__dim-line neon-configurator__dim-line--height">
        <span class="neon-configurator__dim-label" data-height-label>0 cm</span>
      </div>

      <div class="neon-configurator__letter-popup" data-letter-popup hidden>
        <p class="neon-configurator__letter-popup-title" data-letter-popup-title>Set colour for</p>
        <div class="neon-configurator__letter-popup-swatches" data-letter-popup-swatches></div>
      </div>
    </div>

    {% assign bg_images = metaobjects["app--414412210177--neon_background_image"].values %}
    {% if bg_images.size > 0 %}
      <div class="neon-configurator__bg-thumbs" data-bg-thumbs>
        {% for bg in bg_images %}
          <button
            type="button"
            class="neon-configurator__bg-thumb{% if forloop.first %} is-selected{% endif %}"
            data-bg-url="{{ bg.image.value | image_url }}"
            title="{{ bg.label.value }}"
            aria-label="{{ bg.label.value }}">
            <img src="{{ bg.image.value | image_url: width: 120 }}" alt="{{ bg.label.value }}" width="60" height="45" loading="lazy">
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="neon-configurator__panel">

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">1. Enter Your Text</label>
      <input type="text" class="neon-configurator__text-input" data-text-input maxlength="50" placeholder="Type your text here">
    </div>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label" for="neon-rotation-{{ block.id }}">Rotate Your Sign</label>
      <div class="neon-configurator__rotation-row">
        <input id="neon-rotation-{{ block.id }}" type="range" class="neon-configurator__rotation" data-rotation-slider min="-180" max="180" step="1" value="0">
        <span class="neon-configurator__rotation-value" data-rotation-value>0°</span>
      </div>
    </div>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">Quick Symbols (optional)</label>
      <div class="neon-configurator__symbols" data-symbol-buttons>
        {% for symbol in metaobjects["app--414412210177--neon_quick_symbol"].values %}
          <button
            type="button"
            class="neon-configurator__symbol-btn"
            data-symbol-url="{{ symbol.icon.value.url }}"
            data-symbol-label="{{ symbol.label.value }}"
            title="{{ symbol.label.value }}"
            aria-label="{{ symbol.label.value }}">
            <img src="{{ symbol.icon.value.url }}" alt="{{ symbol.label.value }}" width="18" height="18" loading="lazy">
          </button>
        {% endfor %}
      </div>
    </div>

    {% comment %} Dynamic @font-face injection for merchant-uploaded font files {% endcomment %}
    <style>
    {% for font in metaobjects["app--414412210177--neon_font"].values %}
      {% if font.font_file.value.url %}
      @font-face {
        font-family: "moz-font-{{ font.handle }}";
        src: url("{{ font.font_file.value.url }}");
        font-display: swap;
      }
      {% endif %}
    {% endfor %}
    </style>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">2. Choose Font</label>
      <select class="neon-configurator__select" data-font-select>
        {% for font in metaobjects["app--414412210177--neon_font"].values %}
          {% if font.font_file.value.url %}
            {% assign font_value = "moz-font-" | append: font.handle %}
          {% else %}
            {% assign font_value = font.css_font_family.value %}
          {% endif %}
          <option value="{{ font_value }}" {% if forloop.first %}selected{% endif %}>
            {{ font.name.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    {% assign effect_modes = metaobjects["app--414412210177--neon_effect_mode"].values %}
    {% assign has_single_mode = false %}
    {% for mode in effect_modes %}
      {% if mode.mode_key.value == "single" %}
        {% assign has_single_mode = true %}
      {% endif %}
    {% endfor %}
    {% if effect_modes.size > 0 %}
    <div class="neon-configurator__field">
      <label class="neon-configurator__label">Colour Effect</label>
      <div class="neon-configurator__effect-modes" data-effect-modes>
        {% for mode in effect_modes %}
          <label class="neon-configurator__effect-mode-option">
            <input
              type="radio"
              name="neon-effect-mode-{{ block.id }}"
              data-effect-mode-radio
              value="{{ mode.mode_key.value }}"
              data-price="{{ mode.extra_price_decimal.value | default: 0 }}"
              {% if mode.mode_key.value == "single" %}checked{% elsif has_single_mode == false and forloop.first %}checked{% endif %}>
            <span>{{ mode.label.value }}</span>
          </label>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="neon-configurator__field" data-colour-field>
      <label class="neon-configurator__label">3. Choose Colour</label>
      <div class="neon-configurator__swatches" data-colour-swatches>
        {% for colour in metaobjects["app--414412210177--neon_colour"].values %}
          <button
            type="button"
            class="neon-configurator__swatch{% if forloop.first %} is-selected{% endif %}"
            style="background-color: {{ colour.hex_code.value }};"
            data-colour-hex="{{ colour.hex_code.value }}"
            data-colour-price="{{ colour.extra_price_decimal.value | default: 0 }}"
            data-colour-name="{{ colour.name.value }}"
            title="{{ colour.name.value }}"
            aria-label="{{ colour.name.value }}">
          </button>
        {% endfor %}
      </div>
      <p class="neon-configurator__selected-label" data-colour-name-label>
        {{ metaobjects["app--414412210177--neon_colour"].values.first.name.value }}
      </p>
    </div>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">4. Choose Size</label>
      <select class="neon-configurator__select" data-size-select>
        {% for size in metaobjects["app--414412210177--sign_size"].values %}
          <option
            value="{{ size.width_cm.value }}"
            data-price="{{ size.price_decimal.value | default: 0 }}"
            data-height="{{ size.height_cm.value | default: 0 }}"
            {% if forloop.first %}selected{% endif %}>
            {{ size.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    {% assign size_units_count = 0 %}
    {% assign default_unit_entry = nil %}
    {% for u in metaobjects["app--414412210177--neon_size_settings"].values %}
      {% assign size_units_count = size_units_count | plus: 1 %}
      {% if forloop.first %}
        {% assign default_unit_entry = u %}
      {% endif %}
    {% endfor %}
    <div class="neon-configurator__field">
      <label class="neon-configurator__label">Or Set a Custom Size (<span data-slider-unit-label>{{ default_unit_entry.unit.value | default: 'cm' }}</span>)</label>

      {% if size_units_count > 1 %}
      <div class="neon-configurator__unit-tabs" data-unit-tabs>
        {% for u in metaobjects["app--414412210177--neon_size_settings"].values %}
          <button type="button"
            class="neon-configurator__unit-tab{% if forloop.first %} is-selected{% endif %}"
            data-unit-tab
            data-unit="{{ u.unit.value }}"
            data-min="{{ u.min_value.value | default: 0 }}"
            data-max="{{ u.max_value.value | default: 100 }}"
            data-price-per-unit="{{ u.price_per_unit.value | default: 0 }}"
            data-height-ratio="{{ u.height_ratio.value | default: 2.6 }}">
            {{ u.unit.value | upcase }}
          </button>
        {% endfor %}
      </div>
      {% endif %}

      <div class="neon-configurator__slider-meta">
        <span data-slider-width-value>Width: {{ default_unit_entry.min_value.value | default: 20 }} {{ default_unit_entry.unit.value | default: 'cm' }}</span>
        <span data-slider-height-value>Height: -- {{ default_unit_entry.unit.value | default: 'cm' }}</span>
      </div>
      <div class="neon-configurator__slider-row">
        <button type="button" class="neon-configurator__slider-arrow" data-slider-decrease aria-label="Decrease size">‹</button>
        <input type="range"
          class="neon-configurator__slider"
          data-custom-size-slider
          min="{{ default_unit_entry.min_value.value | default: 20 }}"
          max="{{ default_unit_entry.max_value.value | default: 150 }}"
          step="1"
          data-price-per-unit="{{ default_unit_entry.price_per_unit.value | default: 0 }}"
          data-unit="{{ default_unit_entry.unit.value | default: 'cm' }}"
          data-height-ratio="{{ default_unit_entry.height_ratio.value | default: 2.6 }}"
          value="{{ default_unit_entry.min_value.value | default: 20 }}">
        <button type="button" class="neon-configurator__slider-arrow" data-slider-increase aria-label="Increase size">›</button>
      </div>
      <p class="neon-configurator__slider-hint">Drag to request a custom width instead of a preset size above.</p>
    </div>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">5. Backboard Style</label>
      <select class="neon-configurator__select" data-backboard-style-select>
        {% for style in metaobjects["app--414412210177--backboard_style"].values %}
          <option
            value="{{ style.label.value }}"
            data-price="{{ style.extra_price_decimal.value | default: 0 }}"
            data-shape="{{ style.shape_type.value | default: 'rectangle' }}"
            {% if forloop.first %}selected{% endif %}>
            {{ style.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">6. Backboard Colour</label>
      <select class="neon-configurator__select" data-backboard-colour-select>
        {% for colour in metaobjects["app--414412210177--backboard_colour"].values %}
          <option
            value="{{ colour.label.value }}"
            data-price="{{ colour.extra_price_decimal.value | default: 0 }}"
            data-hex="{{ colour.hex_or_swatch.value | default: '#e8e8e8' }}"
            {% if forloop.first %}selected{% endif %}>
            {{ colour.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="neon-configurator__field">
      <label class="neon-configurator__label">7. Add-ons</label>
      {% for addon in metaobjects["app--414412210177--signage_addon"].values %}
        <label class="neon-configurator__checkbox-row">
          <input
            type="checkbox"
            data-addon-checkbox
            data-price="{{ addon.extra_price_decimal.value | default: 0 }}"
            {% if addon.is_free.value %}checked{% endif %}>
          <span>{{ addon.label.value }}{% if addon.is_free.value %} (Free){% endif %}</span>
        </label>
      {% endfor %}
    </div>






    <div class="neon-configurator__field">
      <label class="neon-configurator__label">8. Power Adapter</label>
      <select class="neon-configurator__select" data-power-adapter-select>
        {% for adapter in metaobjects["app--414412210177--power_adapter"].values %}
          <option {% if forloop.first %}selected{% endif %}>
            {{ adapter.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="neon-configurator__price-box">
      <span class="neon-configurator__price-label">Total Price</span>




      <span class="neon-configurator__price-value" data-total-price>$0.00</span>
    </div>

    <button
      type="button"
      class="neon-configurator__add-to-cart"
      data-add-to-cart
      data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}"
      data-product-id="{{ product.id }}">
      Add to Cart
    </button>
    <p class="neon-configurator__status" data-add-to-cart-status></p>

  </div>
</div>

{{ 'neon-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'neon-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Neon Sign Configurator",
  "target": "section",
  "settings": []
}
{% endschema %}