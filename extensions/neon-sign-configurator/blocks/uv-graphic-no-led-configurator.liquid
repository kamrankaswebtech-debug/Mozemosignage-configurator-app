{% comment %} Mozemo Signage - UV Graphic Sign (No LED) Configurator {% endcomment %}

{% comment %} Uses a for-loop instead of ".values.first" — the .first accessor is unreliable once many other metaobject types are accessed later in the same template, silently returning an empty value instead of the real object. A for-loop always resolves correctly. {% endcomment %}
{% assign install_settings = nil %}
{% for entry in metaobjects["app--418838118401--installation_settings"].values %}
  {% assign install_settings = entry %}
  {% break %}
{% endfor %}

<div class="uv-configurator" id="uv-configurator-{{ block.id }}" data-block-id="{{ block.id }}" data-variant="no-led">

  <div class="uv-configurator__preview">
    <div class="uv-configurator__preview-inner" data-preview-box>
      <p class="uv-configurator__preview-placeholder" data-preview-placeholder>
        Upload your design to see a preview
      </p>
      <img class="uv-configurator__preview-image" data-preview-image style="display: none;" alt="Your uploaded design">
    </div>
  </div>

  <div class="uv-configurator__panel">

    <div class="uv-configurator__field">
      <label class="uv-configurator__label">1. Upload Your Design</label>
      <input type="file" class="uv-configurator__file-input" data-file-input accept="image/png,image/jpeg,image/svg+xml,.pdf,.ai">
      <p class="uv-configurator__file-status" data-file-status>PNG, JPG, SVG, PDF or AI file.</p>
    </div>

    <div class="uv-configurator__field">
      <label class="uv-configurator__label">2. Choose Size</label>
      <select class="uv-configurator__select" data-size-select>
        {% for item in metaobjects["app--418838118401--uv_size"].values %}
          <option value="{{ item.width_cm.value }}" data-price="{{ item.price_decimal.value | default: 0 }}" {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="uv-configurator__field">
      <label class="uv-configurator__label">3. Material</label>
      <select class="uv-configurator__select" data-material-select>
        {% for item in metaobjects["app--418838118401--uv_material"].values %}
          <option value="{{ item.label.value }}" data-price="{{ item.extra_price_decimal.value | default: 0 }}" {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="uv-configurator__field">
      <label class="uv-configurator__label">4. Finish</label>
      <select class="uv-configurator__select" data-finish-select>
        {% for item in metaobjects["app--418838118401--uv_finish"].values %}
          <option value="{{ item.label.value }}" data-price="{{ item.extra_price_decimal.value | default: 0 }}" {% if forloop.first %}selected{% endif %}>
            {{ item.label.value }}
          </option>
        {% endfor %}
      </select>
    </div>

    <div class="uv-configurator__field">
      <label class="uv-configurator__label">5. Add-ons</label>
      {% for addon in metaobjects["app--418838118401--uv_addon"].values %}
        <label class="uv-configurator__checkbox-row">
          <input type="checkbox" data-addon-checkbox data-price="{{ addon.extra_price_decimal.value | default: 0 }}" {% if addon.is_free.value %}checked{% endif %}>
          <span>{{ addon.label.value }}{% if addon.is_free.value %} (Free){% endif %}</span>
        </label>
      {% endfor %}
    </div>

    {% if install_settings %}
    <div class="uv-configurator__field uv-configurator__install-field">
      <label class="uv-configurator__label">Need Installation?</label>
      <div class="uv-configurator__install-options" data-install-options>
        <label class="uv-configurator__install-option">
          <input type="radio" name="uv-install-{{ block.id }}" data-install-radio value="no" checked>
          <span>No installation — I will arrange installation myself</span>
        </label>
        <label class="uv-configurator__install-option">
          <input type="radio" name="uv-install-{{ block.id }}" data-install-radio value="yes" data-install-price="{{ install_settings.price_decimal.value | default: 0 }}">
          <span>Yes, I need installation — +${{ install_settings.price_decimal.value | default: 0 }}</span>
        </label>
      </div>

      <div class="uv-configurator__install-booking" data-install-booking hidden
        data-min-lead-days="{{ install_settings.min_lead_days.value | default: 14 }}"
        data-earliest-time="{{ install_settings.earliest_time.value | default: '10:00' }}"
        data-latest-time="{{ install_settings.latest_time.value | default: '17:00' }}"
        data-slot-interval="{{ install_settings.slot_interval_minutes.value | default: 60 }}">
        <p class="uv-configurator__install-notice">
          Sydney area installation, up to 100km. Simple wall/ceiling mounting only — no electrical work. Installation dates require a minimum {{ install_settings.min_lead_days.value | default: 14 }}-day lead time as your sign is manufactured to order.
        </p>
        <div class="uv-configurator__install-row">
          <label class="uv-configurator__install-sublabel" for="uv-install-date-{{ block.id }}">Preferred Installation Date</label>
          <input type="date" id="uv-install-date-{{ block.id }}" class="uv-configurator__select" data-install-date>
        </div>
        <div class="uv-configurator__install-row">
          <label class="uv-configurator__install-sublabel" for="uv-install-time-{{ block.id }}">Preferred Time Slot</label>
          <select id="uv-install-time-{{ block.id }}" class="uv-configurator__select" data-install-time></select>
        </div>
        <div class="uv-configurator__install-row">
          <label class="uv-configurator__install-sublabel" for="uv-install-address-{{ block.id }}">Installation Address (leave blank to use your shipping address)</label>
          <input type="text" id="uv-install-address-{{ block.id }}" class="uv-configurator__select" data-install-address placeholder="Optional — defaults to shipping address">
        </div>
      </div>
    </div>
    {% endif %}

    <div class="uv-configurator__price-box">
      <span class="uv-configurator__price-label">Total Price</span>
      <span class="uv-configurator__price-value" data-total-price>$0.00</span>
    </div>

    <button type="button" class="uv-configurator__add-to-cart" data-add-to-cart
      data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}"
      data-product-id="{{ product.id }}">
      Add to Cart
    </button>
    <p class="uv-configurator__status" data-add-to-cart-status></p>

  </div>
</div>

{{ 'uv-graphic-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'uv-graphic-configurator.js' | asset_url }}" defer></script>

{% schema %}
{ "name": "UV Graphic No LED Config", "target": "section", "settings": [] }
{% endschema %}