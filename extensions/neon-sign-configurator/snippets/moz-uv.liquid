{%- comment -%}
  Graphic LED and Non-LED Neon Signs — one configurator, With or Without Neon Lighting.
  Uses the Neon Admin data (colours, effects, sizes, backboards, Indoor/Outdoor, add-ons) so both
  menus stay the same; UV Sizes only override prices per width, UV Add-ons add UV-only extras.
  Params: block_id, product_id, start ('led' or 'no_led').
{%- endcomment -%}
<div data-moz-cfg="uv" data-block-id="{{ block_id }}" data-product-id="{{ product_id }}">
<script type="application/json" data-moz-data>{"start":{{ start | default: 'led' | json }},
"colours":[{%- for o in metaobjects["app--418838118401--neon_colour"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"n":{{ o.name.value | json }},"h":{{ o.hex_code.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"s":{{ o.sort_order.value | default: 999999 }},"so":{{ o.show_on.value | default: "" | json }}}{%- endfor -%}],
"effects":[{%- for o in metaobjects["app--418838118401--neon_effect_mode"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"l":{{ o.label.value | json }},"k":{{ o.mode_key.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"s":{{ o.sort_order.value | default: 999999 }},"so":{{ o.show_on.value | default: "" | json }}}{%- endfor -%}],
"sizes":[{%- for o in metaobjects["app--418838118401--sign_size"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"l":{{ o.label.value | json }},"w":{{ o.width_cm.value | default: 0 }},"h":{{ o.height_cm.value | default: 0 }},"p":{{ o.price_decimal.value | default: 0 }},"b":{{ o.badge_text.value | default: '' | json }},"s":{{ o.sort_order.value | default: 999999 }},"so":{{ o.show_on.value | default: "" | json }}}{%- endfor -%}],
"uvPrices":[{%- for o in metaobjects["app--418838118401--uv_size"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"w":{{ o.width_cm.value | default: 0 }},"p":{% if o.price_decimal.value != blank %}{{ o.price_decimal.value }}{% else %}null{% endif %},"pn":{% if o.price_no_led_decimal.value != blank %}{{ o.price_no_led_decimal.value }}{% else %}null{% endif %}}{%- endfor -%}],
"styles":[{%- for o in metaobjects["app--418838118401--backboard_style"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"l":{{ o.label.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"s":{{ o.sort_order.value | default: 999999 }},"i":{% if o.preview_image.value %}{{ o.preview_image.value | image_url: width: 240 | json }}{% else %}""{% endif %},"so":{{ o.show_on.value | default: "" | json }}}{%- endfor -%}],
"bcolours":[{%- for o in metaobjects["app--418838118401--backboard_colour"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"l":{{ o.label.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"h":{{ o.hex_or_swatch.value | default: '#e8e8e8' | json }},"c":{% if o.is_clear.value %}true{% else %}false{% endif %},"fi":{{ o.finish_type.value | default: '' | json }},"s":{{ o.sort_order.value | default: 999999 }},"so":{{ o.show_on.value | default: "" | json }}}{%- endfor -%}],
{%- assign uv_t_first = true -%}{%- assign uv_a_first = true -%}{%- capture uv_types -%}{%- for o in metaobjects["app--418838118401--signage_addon"].values -%}{%- if o.category.value == "neon_type" -%}{%- unless uv_t_first -%},{%- endunless -%}{%- assign uv_t_first = false -%}{"k":{{ o.type_key.value | json }},"l":{{ o.label.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"so":{{ o.show_on.value | default: "" | json }}}{%- endif -%}{%- endfor -%}{%- endcapture -%}{%- capture uv_naddons -%}{%- for o in metaobjects["app--418838118401--signage_addon"].values -%}{%- if o.category.value == blank or o.category.value == "addon" -%}{%- unless uv_a_first -%},{%- endunless -%}{%- assign uv_a_first = false -%}{"l":{{ o.label.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"f":{% if o.is_free.value %}true{% else %}false{% endif %},"so":{{ o.show_on.value | default: "" | json }}}{%- endif -%}{%- endfor -%}{%- endcapture -%}
"types":[{{ uv_types }}],
"naddons":[{{ uv_naddons }}],
"fonts":[{%- assign uv_f_first = true -%}{%- for f in metaobjects["app--418838118401--neon_font"].values -%}{%- if f.visibility.value == "3d_only" -%}{%- continue -%}{%- endif -%}{%- unless uv_f_first -%},{%- endunless -%}{%- assign uv_f_first = false -%}{"n":{{ f.name.value | json }},"f":{{ f.css_font_family.value | default: '' | json }},"u":{% if f.font_file.value.url %}{{ f.font_file.value.url | json }}{% else %}""{% endif %},"h":{{ f.system.handle | json }},"p":{% if f.preview_image.value %}{{ f.preview_image.value | image_url: width: 240 | json }}{% else %}""{% endif %},"s":{{ f.sort_order.value | default: 999999 }},"so":{{ f.show_on.value | default: "" | json }}}{%- endfor -%}],
"symbols":[{%- assign uv_s_first = true -%}{%- for sy in metaobjects["app--418838118401--neon_quick_symbol"].values -%}{%- if sy.visibility.value == "3d_only" or sy.icon.value == blank -%}{%- continue -%}{%- endif -%}{%- unless uv_s_first -%},{%- endunless -%}{%- assign uv_s_first = false -%}{"u":{{ sy.icon.value.url | json }},"l":{{ sy.label.value | json }},"s":{{ sy.sort_order.value | default: 999999 }},"so":{{ sy.show_on.value | default: "" | json }}}{%- endfor -%}],
"uaddons":[{%- for o in metaobjects["app--418838118401--uv_addon"].values -%}{%- unless forloop.first -%},{%- endunless -%}{"l":{{ o.label.value | json }},"p":{{ o.extra_price_decimal.value | default: 0 }},"f":{% if o.is_free.value %}true{% else %}false{% endif %},"sf":{{ o.show_for.value | default: 'both' | json }},"s":{{ o.sort_order.value | default: 999999 }}}{%- endfor -%}]}</script>
{%- render 'moz-cfg-common', walls: 'neon', power: true, install: true -%}
</div>
