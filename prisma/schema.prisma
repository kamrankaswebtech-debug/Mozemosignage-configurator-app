// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductionBlueprint {
  id             String    @id @default(cuid())
  shop           String
  shopifyOrderId String
  orderName      String
  orderNumber    Int?
  lineItemId     String
  productTitle   String
  quantity       Int       @default(1)
  customerName   String?
  customerEmail  String?
  destination    String?
  orderStatus    String?
  propertiesJson String
  fileName       String
  pdfData        Bytes
  shareToken     String    @unique @default(cuid())
  createdAt      DateTime  @default(now())
  emailSentAt    DateTime?
  emailSentTo    String?

  @@index([shop])
  @@index([shopifyOrderId])
}

// One row = one installation time slot that is either temporarily HELD (customer picked it
// on the storefront, not yet ordered) or CONFIRMED (order placed). The unique constraint on
// (shop, date, timeSlot) is what makes double bookings impossible at the database level.
// Expired HOLD rows are ignored by availability checks and cleaned up on the next hold.
model InstallationBooking {
  id             String    @id @default(cuid())
  shop           String
  date           String // YYYY-MM-DD (Sydney local date)
  timeSlot       String // e.g. "10:00 AM" — same label the storefront shows
  status         String    @default("HOLD") // HOLD | CONFIRMED
  holdToken      String    @unique
  holdExpiresAt  DateTime?
  address        String?
  distanceKm     Float?
  shopifyOrderId String?
  orderName      String?
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  productTitle   String?
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, date, timeSlot])
  @@index([shop, date])
  @@index([shopifyOrderId])
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
